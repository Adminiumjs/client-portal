# One-shot schema loader, run as a PRE_DEPLOY job.
#
# Compose gets this for free: `docker-entrypoint-initdb.d` runs the schema on an
# empty Postgres volume. A MANAGED database has no such hook — it is handed to
# you already initialised — so the schema has to be applied by something, and on
# DigitalOcean App Platform that something is a pre-deploy job.
#
# Without it, Adminium boots, introspects an empty database, finds no tables and
# generates nothing. The deploy "succeeds" and the product is blank, which is a
# worse failure than a red build because nothing points at the cause.
#
# Idempotent by GUARD, not by construction — and the distinction is the whole
# safety property. `schema.sql` opens with `DROP TABLE ... CASCADE` on every
# table, which is right for the Docker init hook it was written for (once, on an
# empty volume) and destructive here, where a PRE_DEPLOY job runs on every
# deploy. `migrate.sh` therefore applies it only to a database that does not
# already have it. An earlier version of this comment claimed the file used
# `CREATE TABLE IF NOT EXISTS`; it does not, and nobody had looked.
FROM postgres:16-alpine
WORKDIR /db
# Paths are relative to the BUILD CONTEXT, which is the repo root — both for
# App Platform (`source_dir` defaults there) and for a local
# `docker build -f db/Dockerfile.migrate .`. Writing them bare made this file
# buildable only from inside db/, which is the one place nothing builds it.
COPY db/schema.sql db/demo-toolkit.sql db/seed.sql ./
COPY db/migrate.sh /usr/local/bin/migrate.sh
RUN chmod +x /usr/local/bin/migrate.sh
# The script defaults DB_DIR to its OWN directory, which here is
# /usr/local/bin, not where the SQL landed. Stating it beats relying on a
# default that is right locally and wrong in the one place this file exists for.
ENV DB_DIR=/db
CMD ["/usr/local/bin/migrate.sh"]
