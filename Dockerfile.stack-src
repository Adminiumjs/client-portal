# Adminium built FROM SOURCE, with this app's screens baked in.
#
# ─── Why this exists next to `Dockerfile.stack` ─────────────────────────────
#
# `Dockerfile.stack` starts `FROM ghcr.io/mosofi/adminium:latest` and copies the
# built surfaces in. That is the right shape for production and useless for
# testing anything unreleased: `:latest` is whatever was published at the last
# `v*` tag, so a surface feature that has not been released yet produces a
# container holding the surface FILES with no route serving them. The deploy
# succeeds, `/` shows Adminium, and `/apps/<key>/<side>/` returns 404 —
# a failure that looks like a routing bug and is really a release-ordering one.
#
# This variant compiles Adminium from a git ref instead, so a deploy exercises
# the code that actually exists rather than the code that happens to be
# published. It costs build time and buys the ability to verify before releasing.
#
#   docker build -f Dockerfile.stack-src \
#     --build-arg ADMINIUM_REF=main \
#     --build-arg ADMINIUM_REPO=https://github.com/MoSofi/Adminium.git .
#
# Use `Dockerfile.stack` once the feature is in a released image. Two files
# rather than one flag because the DIFFERENCE is the whole point: one pins a
# release, the other pins a commit, and conflating them is how "it worked in
# testing" happens.
#
# ─── What comes out ─────────────────────────────────────────────────────────
#
#   /                        the Adminium dashboard
#   /apps/clients/staff/     the studio  (behind the operator's sign-in)
#   /apps/clients/customer/  the client portal (public, as it must be)

# ─────────────────── stage 1: this app's two surfaces ───────────────────
FROM node:22-slim AS surfaces
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# No VITE_ build args on purpose. A hosted surface takes its backend from the
# origin it was served on, so there is no address to inline and no key to leak;
# passing either would silently switch the build back to the standalone
# transport and put a publishable key in a bundle that does not need one.
RUN npm run build:surface

# ─────────────────── stage 2: Adminium from source ───────────────────
FROM node:22-bookworm AS adminium
ENV CI=true \
    HUSKY=0 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH
# `git` to fetch the ref; the rest mirror the server repo's own build image —
# native addons (better-sqlite3, argon2) need a toolchain to compile against.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates python3 build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable

# A BRANCH is the default because this file exists to test unreleased work, and
# a tag by definition is released. Pass a full SHA to pin one exactly.
ARG ADMINIUM_REPO=https://github.com/MoSofi/Adminium.git
ARG ADMINIUM_REF=main

WORKDIR /repo
# `git init` + fetch rather than `clone`, so a full SHA works even when it is
# not reachable from any branch head — the same reason the marketplace demo
# images do it this way.
RUN git init -q . \
    && git remote add origin "$ADMINIUM_REPO" \
    && git fetch -q --depth 1 origin "$ADMINIUM_REF" \
    && git checkout -q FETCH_HEAD

RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@adminium/server... --filter=@adminium/dashboard...
# The dashboard is bundled INTO the server package — the server serves it, and
# `resolveStaticRoot` looks for it at `<package>/dashboard`.
RUN node apps/server/scripts/bundle-dashboard.mjs
# `--check` re-reads what was written, so a silently empty emit fails the build
# here rather than at a user's terminal. Dropping the second invocation was the
# kind of shortcut that turns a build failure into a runtime one.
RUN node apps/server/scripts/bundle-allowlists.mjs \
    && node apps/server/scripts/bundle-allowlists.mjs --check
RUN pnpm deploy --filter=@adminium/server --prod --legacy /app

# ─────────────────── stage 3: runtime ───────────────────
FROM node:22-slim AS runtime
# dumb-init reaps zombies and forwards signals, so a stop reaches Fastify as a
# real SIGTERM instead of being swallowed by a PID-1 node process.
RUN apt-get update \
    && apt-get install -y --no-install-recommends dumb-init \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    ADMINIUM_DATA_DIR=/data \
    PORT=4600 \
    HOST=0.0.0.0
# `discoverSurfaces` walks <dir>/<appKey>/<side>/index.html, which is exactly
# the layout `build:surface` writes.
ENV ADMINIUM_SURFACES_DIR=/surfaces

WORKDIR /app
COPY --from=adminium --chown=node:node /app /app
COPY --from=surfaces --chown=node:node /app/dist-surface /surfaces

RUN chmod +x /app/dist/cli/index.js \
    && ln -s /app/dist/cli/index.js /usr/local/bin/adminium

# The meta store (users, roles, audit) is a SQLite file here. It does NOT belong
# in the app's own database: dropping that database to reset the app's data
# would take the operator's accounts and audit trail with it.
RUN mkdir -p /data && chown -R node:node /data
VOLUME ["/data"]

USER node
EXPOSE 4600

# Hits the REAL API route and asserts the parsed body. Bare `/healthz` has no
# route, so the SPA history fallback answers it with index.html and a 200 — a
# check there passes while the API is down.
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD ["node", "-e", "fetch(`http://127.0.0.1:${process.env.PORT||4600}/api/v1/healthz`).then(r=>r.ok?r.json():Promise.reject(r.status)).then(b=>process.exit(b.ok===true?0:1)).catch(()=>process.exit(1))"]

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "/app/dist/cli/index.js", "start"]
