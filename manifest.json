{
  "manifestVersion": 1,
  "key": "clients",
  "name": "Client Portal",
  "version": "0.1.2",
  "publisher": {
    "id": "adminium",
    "name": "Adminium",
    "url": "https://adminium.dev"
  },
  "license": "AGPL-3.0-only",
  "description": {
    "key": "mft.clients.desc",
    "fallback": "Proposals, projects and invoices your clients can act on — a studio portal and its invoicing records, backed by your own database."
  },
  "categories": [
    "operations",
    "crm"
  ],
  "compatibility": {
    "minAdminiumVersion": "0.2.8",
    "engines": [
      "postgres",
      "mysql",
      "sqlite"
    ],
    "requires": [
      "file-storage"
    ]
  },
  "requiredSchema": {
    "tables": [
      {
        "ref": "clients",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "company",
            "type": "text"
          },
          {
            "ref": "contact_name",
            "type": "text"
          },
          {
            "ref": "email",
            "type": "text",
            "semantic": "email"
          },
          {
            "ref": "phone",
            "type": "text"
          },
          {
            "ref": "kind",
            "type": "text"
          },
          {
            "ref": "tint",
            "type": "text"
          },
          {
            "ref": "icon",
            "type": "text"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "proposals",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "number",
            "type": "text"
          },
          {
            "ref": "client_id",
            "type": "fk",
            "references": "clients"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "draft",
              "sent",
              "accepted",
              "declined"
            ]
          },
          {
            "ref": "valid_until",
            "type": "date"
          },
          {
            "ref": "tax_rate",
            "type": "decimal"
          },
          {
            "ref": "scope",
            "type": "text"
          },
          {
            "ref": "decline_note",
            "type": "text"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          },
          {
            "ref": "sent_at",
            "type": "timestamptz"
          },
          {
            "ref": "decided_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "proposal_items",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "proposal_id",
            "type": "fk",
            "references": "proposals"
          },
          {
            "ref": "position",
            "type": "int"
          },
          {
            "ref": "description",
            "type": "text"
          },
          {
            "ref": "qty",
            "type": "decimal"
          },
          {
            "ref": "rate",
            "type": "money"
          },
          {
            "ref": "discount_pct",
            "type": "decimal"
          },
          {
            "ref": "line_total",
            "type": "money"
          }
        ]
      },
      {
        "ref": "projects",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "client_id",
            "type": "fk",
            "references": "clients"
          },
          {
            "ref": "proposal_id",
            "type": "fk",
            "references": "proposals"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "active",
              "paused",
              "done"
            ]
          },
          {
            "ref": "due_on",
            "type": "date"
          }
        ]
      },
      {
        "ref": "milestones",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "project_id",
            "type": "fk",
            "references": "projects"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "due_on",
            "type": "date"
          },
          {
            "ref": "done",
            "type": "bool"
          },
          {
            "ref": "position",
            "type": "int"
          }
        ]
      },
      {
        "ref": "deliverables",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "milestone_id",
            "type": "fk",
            "references": "milestones"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "file",
            "type": "text",
            "semantic": "image"
          },
          {
            "ref": "icon",
            "type": "text"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "pending",
              "approved",
              "changes_requested"
            ]
          },
          {
            "ref": "note",
            "type": "text"
          }
        ]
      },
      {
        "ref": "invoices",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "number",
            "type": "text"
          },
          {
            "ref": "client_id",
            "type": "fk",
            "references": "clients"
          },
          {
            "ref": "project_id",
            "type": "fk",
            "references": "projects"
          },
          {
            "ref": "title",
            "type": "text"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "draft",
              "sent",
              "paid",
              "overdue"
            ]
          },
          {
            "ref": "issued_on",
            "type": "date"
          },
          {
            "ref": "due_on",
            "type": "date"
          },
          {
            "ref": "tax_rate",
            "type": "decimal"
          },
          {
            "ref": "created_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "invoice_items",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "invoice_id",
            "type": "fk",
            "references": "invoices"
          },
          {
            "ref": "position",
            "type": "int"
          },
          {
            "ref": "description",
            "type": "text"
          },
          {
            "ref": "qty",
            "type": "decimal"
          },
          {
            "ref": "rate",
            "type": "money"
          },
          {
            "ref": "discount_pct",
            "type": "decimal"
          },
          {
            "ref": "line_total",
            "type": "money"
          }
        ]
      },
      {
        "ref": "payments",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "invoice_id",
            "type": "fk",
            "references": "invoices"
          },
          {
            "ref": "amount",
            "type": "money"
          },
          {
            "ref": "method",
            "type": "enum",
            "enum": [
              "card",
              "transfer"
            ]
          },
          {
            "ref": "paid_at",
            "type": "timestamptz"
          }
        ]
      }
    ]
  },
  "pages": [
    {
      "ref": "clients-dashboard",
      "template": "page-dashboard",
      "title": {
        "key": "mft.clients.page.dashboard",
        "fallback": "Dashboard"
      },
      "nav": {
        "group": "manifest:clients",
        "icon": "layout-dashboard",
        "order": 1
      }
    },
    {
      "ref": "clients-book",
      "template": "page-crud",
      "title": {
        "key": "mft.clients.page.book",
        "fallback": "Clients"
      },
      "nav": {
        "group": "manifest:clients",
        "icon": "users",
        "order": 2
      },
      "bindings": {
        "rows": "clients"
      }
    },
    {
      "ref": "clients-proposals",
      "template": "page-crud",
      "title": {
        "key": "mft.clients.page.proposals",
        "fallback": "Proposals"
      },
      "nav": {
        "group": "manifest:clients",
        "icon": "file-text",
        "order": 3
      },
      "bindings": {
        "rows": "proposals"
      }
    },
    {
      "ref": "clients-invoices",
      "template": "page-crud",
      "title": {
        "key": "mft.clients.page.invoices",
        "fallback": "Invoices"
      },
      "nav": {
        "group": "manifest:clients",
        "icon": "receipt-text",
        "order": 4
      },
      "bindings": {
        "rows": "invoices"
      }
    },
    {
      "ref": "clients-projects",
      "template": "page-board",
      "title": {
        "key": "mft.clients.page.projects",
        "fallback": "Projects"
      },
      "nav": {
        "group": "manifest:clients",
        "icon": "kanban",
        "order": 5
      },
      "bindings": {
        "rows": "projects"
      }
    }
  ],
  "capabilities": [
    "payments",
    "file-storage",
    "email-delivery"
  ],
  "kind": "app",
  "frontends": [
    {
      "side": "staff",
      "kind": "spa",
      "entry": "index.html",
      "env": {
        "VITE_ADMINIUM_API_BASE_URL": {
          "required": false,
          "example": "https://admin.example.com"
        },
        "VITE_ADMINIUM_PUBLISHABLE_KEY": {
          "required": false,
          "example": "adm_pub_..."
        }
      },
      "routes": {
        "studio": "/"
      }
    },
    {
      "side": "customer",
      "kind": "spa",
      "entry": "index.html",
      "env": {
        "VITE_ADMINIUM_API_BASE_URL": {
          "required": false,
          "example": "https://admin.example.com"
        },
        "VITE_ADMINIUM_PUBLISHABLE_KEY": {
          "required": false,
          "example": "adm_pub_..."
        }
      },
      "routes": {
        "portal": "/"
      }
    }
  ]
}
