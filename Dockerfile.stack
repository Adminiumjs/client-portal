# Adminium with this app's own screens baked in — the whole product in ONE
# container, for hosts that give you a database and a service and nothing else.
#
# ─── Why this exists, and why it is not the other Dockerfile ─────────────────
#
# `Dockerfile` builds the app as a STANDALONE static site: Caddy serving
# `dist/`, talking to an Adminium somewhere else with a publishable key baked in
# at build time. That works, and it is the right shape when the front end lives
# on its own domain.
#
# It is the WRONG shape for a one-click "give me the whole thing" deploy, and
# the reason is a chicken-and-egg the old DigitalOcean template walked straight
# into: the key can only be minted from inside a running Adminium, by a person
# who has logged in. On a first deploy nobody has. So the static site builds
# with no key, falls back to its bundled demo data, and the operator gets a
# convincing app full of invented invoices — on their own domain, on their own
# bill. That is what this file removes.
#
# Here the app is served BY Adminium instead, at the same origin, so it needs no
# key at all: the browser already holds the operator's session cookie, and the
# screens read `/api/v1/*` with the same RBAC and the same audit trail as the
# dashboard. Nothing has to be configured after the deploy for it to work.
#
# ─── What comes out ──────────────────────────────────────────────────────────
#
#   /                     the Adminium dashboard
#   /apps/clients/staff/     the studio  (behind the operator's sign-in)
#   /apps/clients/customer/  the client portal (public, as it must be)

# --- build the two surfaces ---
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# No VITE_ARGs on purpose. A hosted surface takes its backend from the origin it
# was served on, so there is no address to inline and no key to leak; passing
# either here would silently switch the build back to the standalone transport.
RUN npm run build:surface

# --- serve everything from Adminium ---
FROM ghcr.io/mosofi/adminium:latest
# `discoverSurfaces` walks <dir>/<appKey>/<side>/index.html, which is exactly
# the layout `build:surface` writes, so the copy is a straight move.
COPY --from=build /app/dist-surface /surfaces
ENV ADMINIUM_SURFACES_DIR=/surfaces
# The meta store (users, roles, audit) is a SQLite file here. It does NOT belong
# in the app's own database: dropping or recreating that database to reset the
# app's data would take the operator's accounts and audit trail with it.
ENV ADMINIUM_DATA_DIR=/data
