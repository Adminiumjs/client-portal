# Copy this file to `.env` and set a real secret before any non-demo use.
# Generate a 32-byte hex secret with:  openssl rand -hex 32
ADMINIUM_SECRET=

# Load the demo data on first boot? Default 1 (yes) — the app comes up with a
# working set of realistic rows. Set to 0 to start with an empty database that
# still has the full schema. Either way you can change your mind later:
#   npm run demo:import   load it
#   npm run demo:wipe     remove it — your own rows and the schema stay
#   npm run demo:status   see what is loaded
DEMO_DATA=1
